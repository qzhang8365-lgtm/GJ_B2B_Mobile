    "fromPreview_filter_panel_filter_sheet_body": "<div class=\"gj-m-filter\"><div class=\"gj-m-filter-bar\" role=\"toolbar\" aria-label=\"筛选条件\"><button type=\"button\" class=\"gj-m-filter-item\" aria-expanded=\"false\" data-k=\"\"><span class=\"gj-m-filter-item-text\">排序</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button><button type=\"button\" class=\"gj-m-filter-item\" aria-expanded=\"true\" data-k=\"\"><span class=\"gj-m-filter-item-text\">类型</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button><button type=\"button\" class=\"gj-m-filter-item\" aria-expanded=\"false\" data-k=\"\"><span class=\"gj-m-filter-item-text\">风险等级</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button><button type=\"button\" class=\"gj-m-filter-item gj-m-filter-item-icon\" aria-expanded=\"false\" aria-haspopup=\"dialog\" data-k=\"\"><span class=\"gj-m-filter-item-text\">筛选</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button></div><div class=\"gj-m-filter-mask\"></div><div class=\"gj-m-filter-panel\"><div class=\"gj-m-filter-sheet-body\"><div class=\"gj-m-filter-group\" role=\"group\" aria-label=\"产品类型（可多选）\"><div class=\"gj-m-filter-group-title\">产品类型（可多选）</div><div class=\"gj-m-filter-options\"><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">股票型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">债券型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"true\"><span class=\"gj-m-filter-option-text\">混合型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">货币型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">指数型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">QDII</span></button></div></div><div class=\"gj-m-filter-group\" role=\"group\" aria-label=\"风险等级\"><div class=\"gj-m-filter-group-title\">风险等级</div><div class=\"gj-m-filter-options\"><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">R1 低风险</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">R2 中低风险</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"true\"><span class=\"gj-m-filter-option-text\">R3 中风险</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">R4 中高风险</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">R5 高风险</span></button></div></div></div><div class=\"gj-m-popup-footer\"><button type=\"button\" class=\"gj-m-button gj-m-button-tertiary gj-m-button-large\" data-act=\"reset\">清空</button><button type=\"button\" class=\"gj-m-button gj-m-button-primary gj-m-button-large\" data-act=\"ok\">确认（2）</button></div></div></div>",
    "filter": "<div class=\"gj-m-filter\"><div class=\"gj-m-filter-bar\" role=\"toolbar\" aria-label=\"筛选条件\"><button type=\"button\" class=\"gj-m-filter-item\" aria-expanded=\"true\" data-k=\"type\"><span class=\"gj-m-filter-item-text\">客户类型</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button><button type=\"button\" class=\"gj-m-filter-item is-active\" aria-expanded=\"false\" data-k=\"risk\"><span class=\"gj-m-filter-item-text\">R3</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button></div><div class=\"gj-m-filter-mask\"></div><div class=\"gj-m-filter-panel\">…</div></div>"
  },
  "interactionMap": {
    "open": "点击触发项展开面板，遮罩覆盖列表区",
    "select": "单选即关闭并生效；多选在面板底部取消 / 确认",
    "active": "有已选条件的项 .is-active（Text/blue）"
  },
  "accessibility": {
    "bar": "role=\"toolbar\" + aria-label",
    "item": "button + aria-expanded（展开面板时 true）",
    "option": "多选项 aria-pressed；单选面板 role=\"radiogroup\" / role=\"radio\" + aria-checked"
  },
  "composition": {
    "count": "1–4 个条件均分；超过 4 个时第 4 项换图标型“筛选”打开全部筛选",
    "edge": "均分模式左右也留 16 页边距（PR-006）",
    "sticky": "与搜索区作为整体吸顶",
    "result": "单选选中即生效；多选点确认生效"
  },
  "pageRules": {
    "PR-006": "筛选栏内容两端不少于 16",
    "PR-018": "顶部筛选区控制高度"
  },
  "pending": {},
  "markupNote": "markup 中 fromPreview_* 片段由 scripts/check-mapping.cjs 从预览页实际渲染补录（2026-10-19），与预览页一致；其余为手写的常用写法。",
  "templates": {
    "filter": {
      "tpl": "<div class=\"gj-m-filter\"><div class=\"gj-m-filter-bar{{#left}} gj-m-filter-bar-left{{/left}}\" role=\"toolbar\" aria-label=\"筛选条件\">{{#items}}<button type=\"button\" class=\"gj-m-filter-item{{#active}} is-active{{/active}}\" aria-expanded=\"{{open}}\"{{#key}} data-k=\"{{key}}\"{{/key}}><span class=\"gj-m-filter-item-text\">{{text}}</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button>{{/items}}</div>{{#panel}}<div class=\"gj-m-filter-mask\"></div><div class=\"gj-m-filter-panel\">{{{panel}}}</div>{{/panel}}</div>",
      "params": "下拉筛选：left：左对齐；items：[{text, active(已选值), open(展开中，true/false), key}]；panel：展开面板内容 HTML（selection-list.single），不展开时不传",
      "example": {
        "items": [
          {
            "text": "客户类型",
            "active": false,
            "open": true,
            "key": "type"
          },
          {
            "text": "R3",
            "active": true,
            "open": false,
            "key": "risk"
          }
        ],
        "panel": "…"
      }
    }
  }
}
