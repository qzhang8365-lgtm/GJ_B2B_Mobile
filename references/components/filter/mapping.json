    "panelSingle": "<div class=\"gj-m-filter-panel\"><div class=\"gj-m-selection\" role=\"radiogroup\"><button type=\"button\" class=\"gj-m-selection-item\" role=\"radio\" aria-checked=\"false\"><span class=\"gj-m-selection-item-content\"><span class=\"gj-m-selection-item-text\">综合排序</span><span class=\"gj-m-selection-check\"><span class=\"gj-icon\" aria-hidden=\"true\"></span></span></span></button><button type=\"button\" class=\"gj-m-selection-item\" role=\"radio\" aria-checked=\"true\"><span class=\"gj-m-selection-item-content\"><span class=\"gj-m-selection-item-text\">近一年收益</span><span class=\"gj-m-selection-check\"><span class=\"gj-icon\" aria-hidden=\"true\"></span></span></span></button><button type=\"button\" class=\"gj-m-selection-item\" role=\"radio\" aria-checked=\"false\"><span class=\"gj-m-selection-item-content\"><span class=\"gj-m-selection-item-text\">近三月收益</span><span class=\"gj-m-selection-check\"><span class=\"gj-icon\" aria-hidden=\"true\"></span></span></span></button><button type=\"button\" class=\"gj-m-selection-item\" role=\"radio\" aria-checked=\"false\"><span class=\"gj-m-selection-item-content\"><span class=\"gj-m-selection-item-text\">最新净值</span><span class=\"gj-m-selection-check\"><span class=\"gj-icon\" aria-hidden=\"true\"></span></span></span></button><button type=\"button\" class=\"gj-m-selection-item\" role=\"radio\" aria-checked=\"false\"><span class=\"gj-m-selection-item-content\"><span class=\"gj-m-selection-item-text\">成立时间</span><span class=\"gj-m-selection-check\"><span class=\"gj-icon\" aria-hidden=\"true\"></span></span></span></button></div></div>",
    "sheetBody": "<div class=\"gj-m-filter-sheet-body\"><div class=\"gj-m-filter-group\" role=\"group\" aria-label=\"产品类型（可多选）\"><div class=\"gj-m-filter-group-title\">产品类型（可多选）</div><div class=\"gj-m-filter-options\"><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">股票型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">债券型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"true\"><span class=\"gj-m-filter-option-text\">混合型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">货币型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">指数型</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">QDII</span></button></div></div><div class=\"gj-m-filter-group\" role=\"group\" aria-label=\"风险等级\"><div class=\"gj-m-filter-group-title\">风险等级</div><div class=\"gj-m-filter-options\"><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">R1 低风险</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">R2 中低风险</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"true\"><span class=\"gj-m-filter-option-text\">R3 中风险</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">R4 中高风险</span></button><button type=\"button\" class=\"gj-m-filter-option\" aria-pressed=\"false\"><span class=\"gj-m-filter-option-text\">R5 高风险</span></button></div></div></div>",
    "fromPreview_filter_filter_panel": "<div class=\"gj-m-filter\"><div class=\"gj-m-filter-bar\" role=\"toolbar\" aria-label=\"筛选条件\"><button type=\"button\" class=\"gj-m-filter-item\" aria-expanded=\"true\" data-k=\"\"><span class=\"gj-m-filter-item-text\">排序</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button><button type=\"button\" class=\"gj-m-filter-item\" aria-expanded=\"false\" data-k=\"\"><span class=\"gj-m-filter-item-text\">类型</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button><button type=\"button\" class=\"gj-m-filter-item\" aria-expanded=\"false\" data-k=\"\"><span class=\"gj-m-filter-item-text\">风险等级</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button><button type=\"button\" class=\"gj-m-filter-item gj-m-filter-item-icon\" aria-expanded=\"false\" aria-haspopup=\"dialog\" data-k=\"\"><span class=\"gj-m-filter-item-text\">筛选</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></button></div><div class=\"gj-m-filter-mask\"></div><div class=\"gj-m-filter-panel\"><div class=\"gj-m-selection\" role=\"radiogroup\"><button type=\"button\" class=\"gj-m-selection-item\" role=\"radio\" aria-checked=\"false\" data-v=\"综合排序\"><span class=\"gj-m-selection-item-content\"><span class=\"gj-m-selection-item-text\">综合排序</span><span class=\"gj-m-selection-check\"><span class=\"gj-icon\" aria-hidden=\"true\"></span></span></span></button><button type=\"button\" class=\"gj-m-selection-item\" role=\"radio\" aria-checked=\"true\" data-v=\"近一年收益\"><span class=\"gj-m-selection-item-content\"><span class=\"gj-m-selection-item-text\">近一年收益</span><span class=\"gj-m-selection-check\"><span class=\"gj-icon\" aria-hidden=\"true\"></span></span></span></button><button type=\"button\" class=\"gj-m-selection-item\" role=\"radio\" aria-checked=\"false\" data-v=\"近三月收益\"><span class=\"gj-m-selection-item-content\"><span class=\"gj-m-selection-item-text\">近三月收益</span><span class=\"gj-m-selection-check\"><span class=\"gj-icon\" aria-hidde