    "clientLabels": "<div class=\"gj-m-client-labels\"><div class=\"gj-m-client-label\"><span class=\"gj-m-client-label-value\">64.4万</span><span class=\"gj-m-client-label-text\">账内资金</span><img class=\"gj-m-client-label-ai\" src=\"{ROOT}assets/icons/business/220/icon_ai.svg\" alt=\"AI 生成\"></div><div class=\"gj-m-client-label\"><span class=\"gj-m-client-label-value\">约200万</span><span class=\"gj-m-client-label-text\">账外资金</span><img class=\"gj-m-client-label-ai\" src=\"{ROOT}assets/icons/business/220/icon_ai.svg\" alt=\"AI 生成\"></div><div class=\"gj-m-client-label\"><span class=\"gj-m-client-label-value\">6月下旬</span><span class=\"gj-m-client-label-text\">资金最早到账时间</span><img class=\"gj-m-client-label-ai\" src=\"{ROOT}assets/icons/business/220/icon_ai.svg\" alt=\"AI 生成\"></div></div>",
