    "reachCardAdvisor": "<div class=\"gj-m-reach-card is-advisor\"><div class=\"gj-m-reach-card-from\"><img src=\"{ROOT}assets/icons/business/220/icon_recommand_red.svg\" alt=\"\">专属顾问<b>李林</b>给您分享</div><h3 class=\"gj-m-reach-card-title\">影子账户</h3><div class=\"gj-m-reach-card-foot\"><span class=\"gj-m-tag gj-m-tag-orange\">这里是介绍/标签/日期</span><button type=\"button\" class=\"gj-m-button gj-m-button-primary\">立刻查看</button></div></div>",
