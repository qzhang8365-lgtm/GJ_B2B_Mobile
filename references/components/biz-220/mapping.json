{
  "$schema": "gj-design-skill/mobile-component-mapping/v2",
  "component": "biz-220",
  "figmaComponent": "【业务组件】220移动端：客户标签 173:9488 / 章节标题 / 待办 207:1003、207:1161、2080:4757 / 客户动态卡片 2080:4753 / APP触达卡片 211:464 / 步骤条 170:5539、170:6858、170:6922 / 分享 1483:1143；图标 2080:3502",
  "prototypeClass": "gj-m-section-title / gj-m-client-label* / gj-m-todo-* / gj-m-dynamic-card* / gj-m-reach-card* / gj-m-task-step* / gj-m-share-*",
  "note": "原型基座类名，不代表真实前端组件库 API。归类在 220 员工端，其它业务可直接复用、参考或做变体（换文案、颜色模式、图标）；变体须沿用同一结构与 Token。",
  "propertyMap": {
    "章节标题": ".gj-m-section-title（::before 为 3×16 品牌蓝竖条）",
    "客户标签 173:9488": ".gj-m-client-labels > .gj-m-client-label > .gj-m-client-label-value + .gj-m-client-label-text + img.gj-m-client-label-ai（可选）",
    "tasklist badge 207:1161 / Notification item 2080:4757": ".gj-m-todo-summary > .gj-m-todo-summary-item > i.gj-m-todo-dot.is-task|is-message|is-chance + 类型 + b 数量",
    "List Item 207:1003": ".gj-m-todo-item > .gj-m-todo-dot + .gj-m-todo-title + (.gj-m-todo-tags > 小号 filled 标签 | .gj-m-todo-note) + span.gj-icon（右箭头，基座内置）",
    "客户动态卡片 2080:4753": ".gj-m-dynamic-card（客户行为）| .is-push（平台推送）> .gj-m-dynamic-card-tag + .gj-m-dynamic-card-head + p.gj-m-dynamic-card-desc",
    "APP触达卡片 211:464": ".gj-m-reach-card（业务办理，可带 .gj-m-reach-card-ribbon）| .is-advisor（专属顾问，按钮自动改国金红全圆角）> .gj-m-reach-card-from + .gj-m-reach-card-title + .gj-m-reach-card-foot",
    "Task_steps / Taskstep_cell / Taskstep": ".gj-m-task-steps > .gj-m-task-step[.is-done|.is-partial][.is-active] > .gj-m-task-step-name + i.gj-m-task-step-bar + .gj-m-task-step-pct；首末段形状按位置自动",
    "增值服务_分享功能 1483:1143": ".gj-m-popup-panel.gj-m-popup-dialog > .gj-m-popup-header + .gj-m-popup-body.gj-m-share-body > .gj-m-share-row[.is-even] > .gj-m-share-item > (img.gj-m-share-icon | .gj-m-share-icon.is-func > .gj-icon) + .gj-m-share-label；可选 p.gj-m-share-hint"
  },
  "icons": "图标见 references/icons/business-manifest.json（scope 220 / share）；彩色图标用 <img>，单色用 gj-icon 遮罩。",
