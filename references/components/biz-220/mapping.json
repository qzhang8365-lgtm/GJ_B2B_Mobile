    "todoItemTags": "<a class=\"gj-m-todo-item\" href=\"#\"><span class=\"gj-m-todo-dot\"></span><span class=\"gj-m-todo-title\">SOP-AI股票解套跟投亏损客户回访</span><span class=\"gj-m-todo-tags\"><span class=\"gj-m-tag gj-m-tag-small gj-m-tag-filled gj-m-tag-red\">紧急</span><span class=\"gj-m-tag gj-m-tag-small gj-m-tag-filled gj-m-tag-blue\">必做</span></span><span class=\"gj-icon\" aria-hidden=\"true\"></span></a>",
    "todoItemNote": "<a class=\"gj-m-todo-item\" href=\"#\"><span class=\"gj-m-todo-dot\"></span><span class=\"gj-m-todo-title\">影子账户签约提醒</span><span class=\"gj-m-todo-note\">必读消息</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></a>",
    "todoItemPlain": "<a class=\"gj-m-todo-item\" href=\"#\"><span class=\"gj-m-todo-dot\"></span><span class=\"gj-m-todo-title\">AI股票解套-近7天无信号客户</span><span class=\"gj-icon\" aria-hidden=\"true\"></span></a>",
    "dynamicCard": "<div class=\"gj-m-dynamic-card\"><span class=\"gj-m-dynamic-card-tag\">客户行为</span><div class=\"gj-m-dynamic-card-head\"><b>13:32</b><b>产品查看</b><span>增值产品</span></div><p class=\"gj-m-dynamic-card-desc\">客户（8880008800）当天存在波段大师访问记录，最早访问时间13点32分</p></div>",
    "dynamicCardPush": "<div class=\"gj-m-dynamic-card is-push\"><span class=\"gj-m-dynamic-card-tag\">平台推送</span><div class=\"gj-m-dynamic-card-head\"><b>13:20</b><b>信号跟随提醒</b><span>增值产品</span></div><p class=\"gj-m-dynamic-card-desc\">客户（8880008800）跟随波段大师参数创建波段步步赢条件单已触发止损，请关注并跟进服务</p></div>",
