{
  "$schema": "gj-design-skill/mobile-component-mapping/v2",
  "component": "form",
  "figmaComponent": "表单 Form（155:2401）：Form_item/Title、Form_input、Form_select、Form_dateselect、Form_switch、Form_slotcard",
  "prototypeClass": "gj-m-form-item / gj-m-form-card",
  "note": "原型基座类名，不代表真实前端组件库 API。",
  "propertyMap": {
    "Form_item/Title": "span.gj-m-form-label > .gj-m-form-label-text (+ .gj-m-form-required / .gj-m-form-desc / button.gj-m-form-tip)",
    "Asterisk=true": ".gj-m-form-required",
    "description=true": ".gj-m-form-desc",
    "Tooltip=true": "button.gj-m-form-tip",
    "Form_input": ".gj-m-form-item > label + label.gj-m-input (+ .gj-m-input-message)",
    "Form_select": ".gj-m-form-item > label + button.gj-m-select (+ .gj-m-select-message)",
    "Form_dateselect": ".gj-m-form-item > label + button.gj-m-select.gj-m-datepicker (+ .gj-m-select-message)",
    "Required / Filled / Disabled / Error": "星号 / 控件有值 / 控件 disabled / 控件 aria-invalid + message",
    "Form_switch Size=Default|Small": ".gj-m-form-item.gj-m-form-item-inline > label + button.gj-m-switch(.gj-m-switch-sm)",
    "Form_slotcard": ".gj-m-form-card > h2.gj-m-form-card-title + 表单项（通栏表单区块）；页面分组用 .gj-m-card（见 composition.group）",
    "组件说明 操作区": ".gj-m-form-actions > .gj-m-button.gj-m-button-large ×2"
  },
  "valueMap": {
    "card": "Background/Container（Figma #ffffff 未绑定），内边距 16，标题 H4-CN-S Text/Primary，与内容间距 12",
    "item": "上内边距 16（2026-10-14 由 12 调整），标题与控件间距 8；控件 L 40；表单项高 86",
    "label": "{\"text\": \"H5-CN-S 14/22 Text/Secondary，间距 4\", \"required\": \"* Feedback/error&rise，标题后\", \"desc\": \"P3_CN-R Text/Tiatery，括注\", \"tip\": \"icf_system_question 16 Text/Tiatery，热区 44\"}",
    "controlStyle": "{\"all\": \"填充式 Style=default（Background/Background + Border/default），2026-10-14 统一\"}",
    "error": "控件下方 4，P5 12/18 Feedback/error&rise（输入框、选择器、日期一致）",
    "inline": "开关项：顶部留白 16、底部 0（与其他表单项一致），标题与开关两端对齐，间距 12；开关 Default 48×28 / Small 32×20",
    "actions": "底部按钮组：草稿 / 提交、上一步 / 下一步，大号按钮等分，间距 12"
  },
  "tokenMap": {
    "Text/Secondary": "--ds-text-secondary",
    "Text/Tiatery": "--ds-text-tiatery",
    "Text/Primary": "--ds-text-primary",
    "Feedback/error&rise": "--ds-feedback-error-rise",
    "Background/Container": "--ds-background-container"
  },
  "runtimeMap": {
    "item": ".gj-m-form-item",
    "inline": ".gj-m-form-item-inline",
    "label": ".gj-m-form-label",
    "labelText": ".gj-m-form-label-text",
    "required": ".gj-m-form-required",
    "desc": ".gj-m-form-desc",
    "card": ".gj-m-form-card",
    "cardTitle": ".gj-m-form-card-title",
    "actions": ".gj-m-form-actions"
  },
  "markup": {
    "input": "<div class=\"gj-m-form-item\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">客户名称</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span></span><label class=\"gj-m-input\"><input type=\"text\" placeholder=\"与证件姓名一致\" aria-label=\"客户名称\"></label></div>",
    "select": "<div class=\"gj-m-form-item\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">客户类型</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span></span><button type=\"button\" class=\"gj-m-select\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-label=\"客户类型\"><span class=\"gj-m-select-value is-placeholder\">请选择</span><span class=\"gj-m-select-arrow\"><span class=\"gj-icon\" style=\"--gj-icon:url('{ROOT}assets/icons/iconfont/icf_Arrow_down.svg')\" aria-hidden=\"true\"></span></span></button></div>",
    "error": "<div class=\"gj-m-form-item\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">手机号</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span></span><label class=\"gj-m-input is-error\"><input type=\"tel\" inputmode=\"numeric\" value=\"138 1234 567\" aria-label=\"手机号\" aria-invalid=\"true\"></label><div class=\"gj-m-input-message\" role=\"alert\">请输入 11 位手机号</div></div>",
    "textareaOptional": "<div class=\"gj-m-form-item\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">处理说明</span><span class=\"gj-m-form-desc\">（选填）</span></span><label class=\"gj-m-textarea\"><textarea rows=\"3\" maxlength=\"200\" placeholder=\"补充处理进展或原因\" aria-label=\"处理说明\"></textarea><span class=\"gj-m-textarea-count\">0/200</span></label></div>",
    "switchInline": "<div class=\"gj-m-form-item gj-m-form-item-inline\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">接收审批通知</span></span><button type=\"button\" class=\"gj-m-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"接收审批通知\"></button></div>",
    "multiChoice": "<div class=\"gj-m-form-item\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">拜访对象</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span></span><div class=\"gj-m-button-group\" role=\"group\" aria-label=\"拜访对象\"><button type=\"button\" class=\"gj-m-button gj-m-button-secondary is-pressed\" aria-pressed=\"true\">行长</button><button type=\"button\" class=\"gj-m-button gj-m-button-tertiary\" aria-pressed=\"false\">理财经理</button></div></div>",
    "card": "<section class=\"gj-m-card\"><div class=\"gj-m-card-head\"><div class=\"gj-m-card-header\"><h3 class=\"gj-m-card-title\">基本信息</h3></div></div><div class=\"gj-m-card-body\"><div class=\"gj-m-form-item\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">客户名称</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span></span><label class=\"gj-m-input\"><input type=\"text\" placeholder=\"与证件姓名一致\" aria-label=\"客户名称\"></label></div><div class=\"gj-m-form-item\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">客户类型</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span></span><button type=\"button\" class=\"gj-m-select\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-label=\"客户类型\"><span class=\"gj-m-select-value is-placeholder\">请选择</span><span class=\"gj-m-select-arrow\"><span class=\"gj-icon\" style=\"--gj-icon:url('{ROOT}assets/icons/iconfont/icf_Arrow_down.svg')\" aria-hidden=\"true\"></span></span></button></div></div></section>",
    "actions": "<div class=\"gj-m-form-actions\"><button type=\"button\" class=\"gj-m-button gj-m-button-large gj-m-button-tertiary\">草稿</button><button type=\"button\" class=\"gj-m-button gj-m-button-large gj-m-button-primary\">提交</button></div>",
    "slotcard": "<section class=\"gj-m-form-card\"><h2 class=\"gj-m-form-card-title\">基本信息</h2><div class=\"gj-m-form-item\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">客户名称</span></span><label class=\"gj-m-input\"><input type=\"text\" placeholder=\"与证件姓名一致\" aria-label=\"客户名称\"></label></div></section>",
    "fromPreview_form_card_form_item_inline": "<div class=\"gj-m-form-card\"><h2 class=\"gj-m-form-card-title\">基本信息</h2>\n          <div class=\"gj-m-form-item\" data-k=\"name\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">客户名称</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span></span><label class=\"gj-m-input\"><input placeholder=\"请输入\" value=\"\" aria-label=\"客户名称\"><button type=\"button\" class=\"gj-m-input-clear\" aria-label=\"清除\"><span class=\"gj-icon\" style=\"--gj-icon:url('{ROOT}assets/icons/iconfont/icf_system_close-circle-fill.svg')\" aria-hidden=\"true\"></span></button></label></div>\n          <div class=\"gj-m-form-item\" data-k=\"type\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">客户类型</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span><button type=\"button\" class=\"gj-m-form-tip\" aria-label=\"客户类型说明\"><span class=\"gj-icon\" aria-hidden=\"true\"></span></button></span><button type=\"button\" class=\"gj-m-select\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-label=\"客户类型\"><span class=\"gj-m-select-value is-placeholder\">选择内容</span><span class=\"gj-m-select-arrow\"><span class=\"gj-icon\" aria-hidden=\"true\"></span></span></button></div>\n          <div class=\"gj-m-form-item\" data-k=\"date\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">开户日期</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span></span><button type=\"button\" class=\"gj-m-select gj-m-datepicker\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-label=\"开户日期\"><span class=\"gj-icon\" style=\"--gj-icon:url('{ROOT}assets/icons/iconfont/icf_system_calendar.svg')\" aria-hidden=\"true\"></span><span class=\"gj-m-select-value is-placeholder\">选择日期</span></button></div>\n          <div class=\"gj-m-form-item\" data-k=\"phone\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">联系电话</span><span class=\"gj-m-form-desc\">(选填)</span></span><label class=\"gj-m-input\"><input placeholder=\"请输入\" value=\"\" aria-label=\"联系电话\"><button type=\"button\" class=\"gj-m-input-clear\" aria-label=\"清除\"><span class=\"gj-icon\" style=\"--gj-icon:url('{ROOT}assets/icons/iconfont/icf_system_close-circle-fill.svg')\" aria-hidden=\"true\"></span></button></label></div>\n          <div class=\"gj-m-form-item gj-m-form-item-inline\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">接收审批通知</span></span><button type=\"button\" class=\"gj-m-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"接收审批通知\"></button></div></div>",
    "fromPreview_form_slider_form_label": "<div class=\"gj-m-form-slider\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">风险偏好</span></span><div class=\"gj-m-slider-step\" style=\"--gj-m-slider-n:4\"><ul class=\"gj-m-slider-labels\" aria-hidden=\"true\"><li style=\"--i:0\">保守</li><li style=\"--i:1\">稳健</li><li style=\"--i:2\" class=\"is-current\">平衡</li><li style=\"--i:3\">进取</li></ul><div class=\"gj-m-slider-rail\"><input type=\"range\" class=\"gj-m-slider\" min=\"0\" max=\"3\" step=\"1\" value=\"2\" aria-label=\"风险偏好\" aria-valuetext=\"平衡\"></div></div></div>",
    "label": "<span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">拜访对象</span><span class=\"gj-m-form-required\" aria-label=\"必填\">*</span><span class=\"gj-m-form-desc\">(可多选)</span></span>",
    "item": "<div class=\"gj-m-form-item\" data-k=\"note\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">处理说明</span></span>…</div>"
  },
  "interactionMap": {
    "validate": "提交时校验，错误紧贴控件下方 4；修改后清除",
    "submit": "提交中主按钮 disabled + “提交中...”"
  },
  "accessibility": {
    "label": "可见标签 + 控件 aria-label 或 aria-labelledby；必填星号 aria-label=\"必填\"",
    "error": "控件 aria-invalid + 错误提示 role=\"alert\"（可用 aria-describedby 关联）",
    "tip": "说明图标按钮 aria-label，热区 44"
  },
  "composition": {
    "spacing": "表单项上内边距 16，标题与控件 8；卡片内边距 16，标题与内容 12",
    "controls": "全部用填充式、L 40",
    "multi": "卡片内多选用按钮组合（PR-009）",
    "actions": "底部按钮组 Large 等分，间距 12；固定底栏见 detail 模式",
    "group": "页面中的表单分组用一级卡片（.gj-m-card + .gj-m-card-body，圆角 12，PR-008），每组一张，卡片标题为组名；这是分组表单模式的已确认写法（markup.card）。卡片内首个表单项的上内边距由基座清零（PR-007）",
    "slotcard": ".gj-m-form-card 对应 Figma Form_slotcard（无圆角、整宽白底），只用于通栏表单区块；放在灰底页面上作为分组时改用 markup.card"
  },
  "pageRules": {
    "PR-009": "卡片内多选用按钮组合",
    "PR-010": "表单项不用 min-height 撑开，标签到控件 8"
  },
  "pending": {
    "FM-M-009": "Form_select 与 Form_dateselect 变体数不一致，暂不处理"
  },
  "markupNote": "markup 中 fromPreview_* 片段由 scripts/check-mapping.cjs 从预览页实际渲染补录（2026-10-19），与预览页一致；其余为手写的常用写法。",
  "templates": {
    "label": {
      "tpl": "<span class=\"gj-m-form-label\"{{#id}} id=\"{{id}}\"{{/id}}><span class=\"gj-m-form-label-text\">{{text}}</span>{{#required}}<span class=\"gj-m-form-required\" aria-label=\"必填\">*</span>{{/required}}{{#desc}}<span class=\"gj-m-form-desc\">({{desc}})</span>{{/desc}}</span>",
      "example": {
        "text": "拜访对象",
        "required": true,
        "desc": "可多选"
      },
      "params": "表单项标题"
    },
    "item": {
      "tpl": "<div class=\"gj-m-form-item\" data-k=\"{{key}}\">{{{label}}}{{{control}}}{{#error}}<div class=\"gj-m-input-message\" role=\"alert\">{{error}}</div>{{/error}}</div>",
      "example": {
        "key": "note",
        "label": "<span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">处理说明</span></span>",
        "control": "…",
        "error": ""
      },
      "params": "表单项：label 为 form.label；control 为控件 HTML；error 为错误文案"
    }
  }
}
