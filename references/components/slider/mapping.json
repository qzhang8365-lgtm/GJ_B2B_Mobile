{
  "$schema": "gj-design-skill/mobile-component-mapping/v2",
  "component": "slider",
  "figmaComponent": "Slider（1832:49）/ Form_slider（1008:4851）/ Form_slider_rule（1008:4898）",
  "prototypeClass": "gj-m-slider",
  "note": "原型基座类名，不代表真实前端组件库 API。",
  "propertyMap": {
    "Slider Type=Continuous": "input[type=range].gj-m-slider（--gj-m-slider-pct 已选比例）",
    "Slider Type=Step": ".gj-m-slider-step[--gj-m-slider-n] > ul.gj-m-slider-labels > li[--i](.is-current) + .gj-m-slider-rail > input[type=range].gj-m-slider[step=1]",
    "State=Disabled": "input:disabled（刻度容器加 .is-disabled）",
    "Form_slider": ".gj-m-form-slider > .gj-m-form-slider-head(.gj-m-form-label + .gj-m-form-slider-value) + .gj-m-slider",
    "Form_slider_rule": ".gj-m-form-slider > .gj-m-form-label + .gj-m-slider-step"
  },
  "valueMap": {
    "continuous": "{\"track\": \"高 8，圆角 4，Background/Secondary；已选段 Brand/GJ_Blue\", \"thumb\": \"28 圆，Background/Container + shadow_small\", \"hitArea\": \"控件高 44，外边距抵消后版面高度 8\"}",
    "step": "{\"labels\": \"P3_CN-R 14/22 Text/Tiatery，当前档 Text/Primary；首末标签贴边，中间标签对准刻度\", \"gap\": \"标签与刻度 12\", \"rail\": \"刻度线 2×15、横线高 2，Border/secondary；首末刻度中心距两侧 13\", \"thumb\": \"28，中心落在刻度上\"}",
    "disabled": "整体 40%",
    "form": "上 8 下 12，标题行与滑块间距 12；数值 N4_NUM-S 20/30 Text/Primary"
  },
  "tokenMap": {
    "Background/Secondary": "--ds-background-secondary",
    "Brand/GJ_Blue": "--ds-brand-gj-blue",
    "Background/Container": "--ds-background-container",
    "shadow_small": "--ds-effect-shadow-small",
    "Border/secondary": "--ds-border-secondary",
    "Text/Tiatery": "--ds-text-tiatery",
    "Text/Primary": "--ds-text-primary"
  },
  "runtimeMap": {
    "input": "input.gj-m-slider",
    "step": ".gj-m-slider-step",
    "labels": ".gj-m-slider-labels",
    "rail": ".gj-m-slider-rail",
    "form": ".gj-m-form-slider"
  },
  "markup": {
    "continuous": "<input type=\"range\" class=\"gj-m-slider\" min=\"0\" max=\"100\" step=\"1\" value=\"70\" style=\"--gj-m-slider-pct:70%\" aria-label=\"比例\" aria-valuetext=\"70%\">",
    "step": "<div class=\"gj-m-slider-step\" style=\"--gj-m-slider-n:4\"><ul class=\"gj-m-slider-labels\" aria-hidden=\"true\"><li style=\"--i:0\">保守</li><li style=\"--i:1\">稳健</li><li style=\"--i:2\" class=\"is-current\">平衡</li><li style=\"--i:3\">进取</li></ul><div class=\"gj-m-slider-rail\"><input type=\"range\" class=\"gj-m-slider\" min=\"0\" max=\"3\" step=\"1\" value=\"2\" aria-label=\"档位\" aria-valuetext=\"平衡\"></div></div>",
    "form": "<div class=\"gj-m-form-slider\"><div class=\"gj-m-form-slider-head\"><span class=\"gj-m-form-label\"><span class=\"gj-m-form-label-text\">投资比例</span></span><span class=\"gj-m-form-slider-value\" aria-hidden=\"true\">70%</span></div><input type=\"range\" class=\"gj-m-slider\" min=\"0\" max=\"100\" step=\"1\" value=\"70\" style=\"--gj-m-slider-pct:70%\" aria-label=\"投资比例\" aria-valuetext=\"70%\"></div>"
  },
  "interactionMap": {
    "drag": "拖动更新 --gj-m-slider-pct 与数值显示；档位型吸附到刻度并更新 .is-current"
  },
  "accessibility": {
    "input": "原生 input[type=range] + aria-label + aria-valuetext"
  },
  "composition": {
    "form": "表单内上 8 下 12，标题行与滑块间距 12；数值 N4 20/30"
  },
  "pageRules": {},
  "pending": {}
}