    "fromPreview_chart_tip_chart_tip_name": "<div class=\"gj-m-chart-axes\" style=\"--gj-m-chart-h:1.4rem;--gj-m-chart-y-w:0.19rem\"><div class=\"gj-m-chart-ytick\" style=\"top:0%\"><span class=\"gj-m-chart-ylabel\">8</span></div><div class=\"gj-m-chart-ytick\" style=\"top:25%\"><span class=\"gj-m-chart-ylabel\">6</span></div><div class=\"gj-m-chart-ytick\" style=\"top:50%\"><span class=\"gj-m-chart-ylabel\">4</span></div><div class=\"gj-m-chart-ytick\" style=\"top:75%\"><span class=\"gj-m-chart-ylabel\">2</span></div><div class=\"gj-m-chart-ytick is-solid\" style=\"top:100%\"><span class=\"gj-m-chart-ylabel\">0</span></div><div class=\"gj-m-chart-plot\"><svg class=\"gj-m-chart-line-svg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><polyline class=\"gj-m-chart-line gj-m-chart-s1\" points=\"0.00,100.00 11.11,85.00 22.22,90.00 33.33,67.50 44.44,61.25 55.56,70.00 66.67,52.50 77.78,42.50 88.89,47.50 100.00,35.00\"></polyline></svg><div class=\"gj-m-chart-indicator\" style=\"left:77.78%\"><span class=\"gj-m-chart-indicator-dot gj-m-chart-s1\" style=\"top:42.50%\"></span></div><div class=\"gj-m-chart-tip gj-m-chart-tip-single is-left\" style=\"--x:77.78\"><span class=\"gj-m-chart-tip-name gj-m-chart-s1\">我的组合</span><span class=\"gj-m-chart-tip-value\">+4.60<span class=\"gj-m-chart-tip-unit\">%</span></span></div></div></div>",
    "fromPreview_chart_bar_group_chart_s2": "<div class=\"gj-m-chart-axes\" style=\"--gj-m-chart-h:1.4rem;\"><div class=\"gj-m-chart-ytick\" style=\"top:0%\"><span class=\"gj-m-chart-ylabel\">80</span></div><div class=\"gj-m-chart-ytick\" style=\"top:25%\"><span class=\"gj-m-chart-ylabel\">60</span></div><div class=\"gj-m-chart-ytick\" style=\"top:50%\"><span class=\"gj-m-chart-ylabel\">40</span></div><div class=\"gj-m-chart-ytick\" style=\"top:75%\"><span class=\"gj-m-chart-ylabel\">20</span></div><div class=\"gj-m-chart-ytick is-solid\" style=\"top:100%\"><span class=\"gj-m-chart-ylabel\">0</span></div><div class=\"gj-m-chart-plot\"><div class=\"gj-m-chart-bars\"><div class=\"gj-m-chart-bar-group is-grouped\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:52.5\"></div><div class=\"gj-m-chart-bar gj-m-chart-s2\" style=\"--v:37.5\"></div></div><div class=\"gj-m-chart-bar-group is-grouped\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:70\"></div><div class=\"gj-m-chart-bar gj-m-chart-s2\" style=\"--v:55.00000000000001\"></div></div><div class=\"gj-m-chart-bar-group is-grouped\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:47.5\"></div><div class=\"gj-m-chart-bar gj-m-chart-s2\" style=\"--v:57.49999999999999\"></div></div><div class=\"gj-m-chart-bar-group is-grouped\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:80\"></div><div class=\"gj-m-chart-bar gj-m-chart-s2\" style=\"--v:50\"></div></div><div class=\"gj-m-chart-bar-group is-grouped\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:62.5\"></div><div class=\"gj-m-chart-bar gj-m-chart-s2\" style=\"--v:72.5\"></div></div><div class=\"gj-m-chart-bar-group is-grouped\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:90\"></div><div class=\"gj-m-chart-bar gj-m-chart-s2\" style=\"--v:65\"></div></div></div></div></div>",
    "fromPreview_chart_pie_wrap_chart_legend": "<div class=\"gj-m-chart-pie-wrap is-stacked\"><div class=\"gj-m-chart-pie gj-m-chart-pie-lg\" role=\"img\" aria-label=\"客户构成：个人55%，机构20%，产品16%，其他9%\"><svg viewBox=\"0 0 100 100\" aria-hidden=\"true\"><path class=\"gj-m-chart-slice gj-m-chart-s1\" d=\"M50,50 L50,0 A50,50 0 1 1 34.549150281252615,97.55282581475768 Z\"></path><path class=\"gj-m-chart-slice gj-m-chart-s2\" d=\"M50,50 L34.549150281252615,97.55282581475768 A50,50 0 0 1 0,50.00000000000001 Z\"></path><path class=\"gj-m-chart-slice gj-m-chart-s3\" d=\"M50,50 L0,50.00000000000001 A50,50 0 0 1 23.208660251050144,7.783603724899265 Z\"></path><path class=\"gj-m-chart-slice gj-m-chart-s4\" d=\"M50,50 L23.208660251050144,7.783603724899265 A50,50 0 0 1 49.999999999999986,0 Z\"></path></svg><span class=\"gj-m-chart-pie-label\" style=\"left:80.61833855844927%;top:54.84946841624716%\">55%</span><span class=\"gj-m-chart-pie-label\" style=\"left:24.92047317437663%;top:68.22134282106667%\">20%</span><span class=\"gj-m-chart-pie-label\" style=\"left:22.834492918640223%;top:35.06563610284684%\">16%</span><span class=\"gj-m-chart-pie-label\" style=\"left:41.35127571278388%;top:20.23089574401477%\">9%</span></div><div class=\"gj-m-chart-legend\"><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s1\"><span class=\"gj-m-legend-mark is-dot\" aria-hidden=\"true\"></span>个人</span><span class=\"gj-m-legend-value\">55%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s2\"><span class=\"gj-m-legend-mark is-dot\" aria-hidden=\"true\"></span>机构</span><span class=\"gj-m-legend-value\">20%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s3\"><span class=\"gj-m-legend-mark is-dot\" aria-hidden=\"true\"></span>产品</span><span class=\"gj-m-legend-value\">16%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s4\"><span class=\"gj-m-legend-mark is-dot\" aria-hidden=\"true\"></span>其他</span><span class=\"gj-m-legend-value\">9%</span></span></div></div>",
    "progress": "<ul class=\"gj-m-chart-progress-list\"><li class=\"gj-m-chart-progress-item\"><div class=\"gj-m-chart-progress-head\"><span class=\"gj-m-chart-progress-name\">五星</span><span class=\"gj-m-chart-progress-value\">2 家</span></div><div class=\"gj-m-chart-progress gj-m-chart-progress-lg\" role=\"progressbar\" aria-valuenow=\"40\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"五星 2 家\"><div class=\"gj-m-chart-progress-bar gj-m-chart-s1\" style=\"--v:40\"></div></div></li></ul>",
    "progressExpand": "<ul class=\"gj-m-chart-progress-list gj-m-chart-progress-list-inline is-expandable\"><li class=\"gj-m-chart-progress-item\"><button type=\"button\" class=\"gj-m-chart-progress-toggle\" data-expand=\"五星\" aria-expanded=\"true\" aria-label=\"五星 2 家，收起明细\"><span class=\"gj-m-chart-progress-name\">五星</span><span class=\"gj-m-chart-progress\" aria-hidden=\"true\"><span class=\"gj-m-chart-progress-bar\" style=\"--v:40\"></span></span><span class=\"gj-m-chart-progress-value\">2 家</span><span class=\"gj-m-chart-progress-caret\" aria-hidden=\"true\"></span></button><ul class=\"gj-m-chart-progress-detail\"><li><a class=\"gj-m-chart-progress-detail-item\" href=\"javascript:void 0\" data-go=\"中国银行东城根支行\"><span>中国银行东城根支行</span><span class=\"gj-icon\" style=\"--gj-icon:url('{ROOT}assets/icons/iconfont/icf_Arrow_right.svg')\" aria-hidden=\"true\"></span></a></li></ul></li><li class=\"gj-m-chart-progress-item\"><button type=\"button\" class=\"gj-m-chart-progress-toggle\" data-expand=\"一星\" disabled aria-label=\"一星 0 家\"><span class=\"gj-m-chart-progress-name\">一星</span><span class=\"gj-m-chart-progress\" aria-hidden=\"true\"><span class=\"gj-m-chart-progress-bar\" style=\"--v:0\"></span></span><span class=\"gj-m-chart-progress-value\">0 家</span><span></span></button></li></ul>",
    "legendList": "<div class=\"gj-m-chart-legend\"><span class=\"gj-m-legend\" style=\"--gj-m-legend-color:var(--ds-chart-ch01)\"><span class=\"gj-m-legend-mark\" aria-hidden=\"true\"></span>拜访</span><span class=\"gj-m-legend\" style=\"--gj-m-legend-color:var(--ds-feedback-warning)\"><span class=\"gj-m-legend-mark\" aria-hidden=\"true\"></span>活动</span></div>",
    "plotViewport": "<svg id=\"examplePlot\" class=\"gj-m-chart-line-svg\" viewBox=\"0 0 320 166\" style=\"display:block;width:100%;height:1.66rem\" role=\"img\" aria-label=\"价格走势示例\"></svg>",
    "rangeNavigator": "<div data-chart-navigator style=\"position:relative;height:.16rem\"><input id=\"exampleWindow\" type=\"range\" min=\"0\" max=\"24\" value=\"24\" aria-label=\"图表历史区间\" style=\"position:absolute;left:0;top:50%;transform:translateY(-50%);width:100%;height:44px;margin:0;accent-color:var(--ds-text-blue)\"></div>"
  },
  "accessibility": {
    "progress": "进度条 role=\"progressbar\" + aria-valuenow / aria-valuemax，或数值文字可读",
    "toggle": "可展开行 button + aria-expanded",
    "legend": "图例标记 aria-hidden，文字说明系列"
  },
  "composition": {
    "distribution": "分布数据用横排单色进度条（default / bar），数值用普通粗体（PR-003）",
    "expand": "需要看明细时行下方就地展开，一次只展开一项，行高 34（PR-004）",
    "series": "系列图形放 .gj-m-chart-plot，SVG preserveAspectRatio=none + vector-effect=non-scaling-stroke",
    "height": "PR-022：绘图视口默认166，非整个卡片的上限。标题、图例、X标签与导航间距用语义变量；空详情不预留固定多行高度，导航44热区不计入布局。"
  },
  "pageRules": {
    "PR-003": "分布数据用横排单色进度条，数值普通粗体",
    "PR-004": "就地展开明细，手风琴，行高 34",
    "PR-022": "图表高度分层计量，默认绘图166，避免占位和热区撑高整体"
  },
  "pending": {
    "CH-M-001": "坐标轴单元命名部分修复",
    "LG-M-003": "环形图等仍用旧图例",
    "ID-M-001": "indicator 未做成变体",
    "TY-M-001": "曲线、横向正负柱等移动端暂无组件"
  },
  "markupNote": "markup 中 fromPreview_* 片段由 scripts/check-mapping.cjs 从预览页实际渲染补录（2026-10-19），与预览页一致；其余为手写的常用写法。",
  "templates": {
    "progress": {
      "tpl": "<ul class=\"gj-m-chart-progress-list\">{{#rows}}<li class=\"gj-m-chart-progress-item\"><div class=\"gj-m-chart-progress-head\"><span class=\"gj-m-chart-progress-name\">{{name}}</span><span class=\"gj-m-chart-progress-value\">{{text}}</span></div><div class=\"gj-m-chart-progress gj-m-chart-progress-lg\" role=\"progressbar\" aria-valuenow=\"{{value}}\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"{{name}} {{text}}\"><div class=\"gj-m-chart-progress-bar gj-m-chart-s{{series}}\" style=\"--v:{{value}}\"></div></div></li>{{/rows}}</ul>",
      "example": {
        "rows": [
          {
            "name": "五星",
            "value": 40,
            "text": "2 家",
            "series": 1
          }
        ]
      },
      "params": "rows：[{name, value(0–100), text, series(1–6)}]"
    },
    "progressInline": {
      "tpl": "<ul class=\"gj-m-chart-progress-list gj-m-chart-progress-list-inline\">{{#rows}}<li class=\"gj-m-chart-progress-item\"><span class=\"gj-m-chart-progress-name\">{{name}}</span><div class=\"gj-m-chart-progress\" role=\"progressbar\" aria-valuenow=\"{{value}}\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"{{name}} {{text}}\"><div class=\"gj-m-chart-progress-bar\" style=\"--v:{{value}}\"></div></div><span class=\"gj-m-chart-progress-value\">{{text}}</span></li>{{/rows}}</ul>",
      "example": {
        "rows": [
          {
            "name": "五星",
            "value": 40,
            "text": "2 家"
          }
        ]
      },
      "params": "横排单色进度（PR-003）"
    },
    "progressExpand": {
      "tpl": "<ul class=\"gj-m-chart-progress-list gj-m-chart-progress-list-inline is-expandable\">{{#rows}}<li class=\"gj-m-chart-progress-item\"><button type=\"button\" class=\"gj-m-chart-progress-toggle\" data-expand=\"{{name}}\"{{#can}} aria-expanded=\"{{open}}\"{{/can}}{{^can}} disabled{{/can}} aria-label=\"{{name}} {{text}}{{hint}}\"><span class=\"gj-m-chart-progress-name\">{{name}}</span><span class=\"gj-m-chart-progress\" aria-hidden=\"true\"><span class=\"gj-m-chart-progress-bar\" style=\"--v:{{value}}\"></span></span><span class=\"gj-m-chart-progress-value\">{{text}}</span>{{#can}}<span class=\"gj-m-chart-progress-caret\" aria-hidden=\"true\"></span>{{/can}}{{^can}}<span></span>{{/can}}</button>{{#open}}<ul class=\"gj-m-chart-progress-detail\">{{#items}}<li><a class=\"gj-m-chart-progress-detail-item\" href=\"javascript:void 0\" data-go=\"{{.}}\"><span>{{.}}</span><span class=\"gj-icon\" style=\"--gj-icon:url('{ROOT}assets/icons/iconfont/icf_Arrow_right.svg')\" aria-hidden=\"true\"></span></a></li>{{/items}}</ul>{{/open}}</li>{{/rows}}</ul>",
      "example": {
        "rows": [
          {
            "name": "五星",
            "value": 40,
            "text": "2 家",
            "can": true,
            "open": true,
            "hint": "，收起明细",
            "items": [
              "中国银行东城根支行"
            ]
          },
          {
            "name": "一星",
            "value": 0,
            "text": "0 家",
            "can": false,
            "open": false,
            "hint": "",
            "items": []
          }
        ]
      },
      "params": "可展开横排进度（PR-004）：rows：[{name, value, text, can(有明细), open(展开中), hint(读屏后缀), items}]"
    },
    "legendList": {
      "tpl": "<div class=\"gj-m-chart-legend{{#cls}} {{cls}}{{/cls}}\">{{#items}}<span class=\"gj-m-legend{{#series}} gj-m-chart-s{{series}}{{/series}}\"{{#color}} style=\"--gj-m-legend-color:{{color}}\"{{/color}}><span class=\"gj-m-legend-mark{{#mark}} is-{{mark}}{{/mark}}\" aria-hidden=\"true\"></span>{{text}}</span>{{/items}}</div>",
      "params": "图例：items：[{text, series(1–6，系列色) 或 color(自定义色，如日历记录点), mark(line / dotline / dot / stack，默认圆点)}]；cls：页面附加类",
      "example": {
        "items": [
          {
            "text": "拜访",
            "color": "var(--ds-chart-ch01)",
            "series": 0,
            "mark": ""
          },
          {
            "text": "活动",
            "color": "var(--ds-feedback-warning)",
            "series": 0,
            "mark": ""
          }
        ]
      }
    },
    "plotViewport": {
      "tpl": "<svg id=\"{{id}}\" class=\"gj-m-chart-line-svg\" viewBox=\"0 0 {{width}} {{#height}}{{height}}{{/height}}{{^height}}166{{/height}}\" style=\"display:block;width:100%;height:{{#heightRem}}{{heightRem}}{{/heightRem}}{{^heightRem}}1.66{{/heightRem}}rem\" role=\"img\" aria-label=\"{{label}}\"></svg>",
      "example": {
        "id": "examplePlot",
        "width": 320,
        "label": "价格走势示例"
      },
      "params": "坐标图绘图视口。id / width（viewBox坐标宽）/ label必填；height默认166，heightRem默认1.66，显式改高时二者需同步。只负责图形区域，不包括标题、图例、X标签、导航；绘图内容由业务脚本填入。"
    },
    "rangeNavigator": {
      "tpl": "<div data-chart-navigator style=\"position:relative;height:.16rem\"><input id=\"{{id}}\" type=\"range\" min=\"{{min}}\" max=\"{{max}}\" value=\"{{value}}\" aria-label=\"{{label}}\" style=\"position:absolute;left:0;top:50%;transform:translateY(-50%);width:100%;height:44px;margin:0;accent-color:var(--ds-text-blue)\"></div>",
      "example": {
        "id": "exampleWindow",
        "min": 0,
        "max": 24,
        "value": 24,
        "label": "图表历史区间"
      },
      "params": "历史区间单滑块导航：id/min/max/value/label；视觉布局高16，原生输入热区44绝对定位，不撑大布局；事件由业务绑定。"
    }
  }
}
