{
  "$schema": "gj-design-skill/mobile-component-mapping/v2",
  "component": "chart",
  "figmaComponent": "图表 Chart：坐标轴、图例、折线、进度条、数据指示器（其余类型参照 PC）",
  "prototypeClass": "gj-m-chart-*",
  "note": "原型基座类名，不代表真实前端组件库 API。",
  "propertyMap": {
    "chart_item/y_axis style=dash": ".gj-m-chart-ytick > .gj-m-chart-ylabel",
    "chart_item/y_axis style=solid": ".gj-m-chart-ytick.is-solid（或容器 .gj-m-chart-axes-solid）",
    "chart_item/x_axis Style=dash（短刻度）": ".gj-m-chart-xaxis.gj-m-chart-xaxis-tick > .gj-m-chart-xtick > .gj-m-chart-xlabel",
    "chart_item/x_axis Style=solid（短刻度）": ".gj-m-chart-xaxis.gj-m-chart-xaxis-tick.gj-m-chart-xaxis-solid",
    "chart_item/y_axis_group": ".gj-m-chart-axes（横向网格 + Y 标签）+ .gj-m-chart-xaxis",
    "chart_item/x_axis_group": ".gj-m-chart-axes.gj-m-chart-axes-v（.gj-m-chart-vtick + .gj-m-chart-ycat）+ .gj-m-chart-xaxis",
    "Chart_item/Legend Style=line": ".gj-m-legend > .gj-m-legend-mark.is-line",
    "Chart_item/Legend Style=dotline": ".gj-m-legend > .gj-m-legend-mark.is-dotline",
    "Chart_item/Legend Style=dot": ".gj-m-legend > .gj-m-legend-mark.is-dot（默认）",
    "Chart_item/Legend Style=stack": ".gj-m-legend > .gj-m-legend-mark.is-stack",
    "Chart_item style=dot|stack（图例 + 数值）": ".gj-m-legend-data > .gj-m-legend + .gj-m-legend-value",
    "chart_item/y_axis_group / 单位": "p.gj-m-chart-unit（紧挨 .gj-m-chart-axes 之前）",
    "chart_line Style=Default": "svg.gj-m-chart-line-svg > polyline.gj-m-chart-line.gj-m-chart-sN",
    "chart_line Style=Fill": "+ defs > linearGradient.gj-m-chart-area-grad.gj-m-chart-sN（x1=0 y1=0 x2=0 y2=1，stop×2）+ path.gj-m-chart-area.gj-m-chart-sN（fill:url(#id)）",
    "chart_line line=N": "N 个系列依次 .gj-m-chart-s1 … -sN",
    "隐藏系列": ".is-off",
    "indicator": ".gj-m-chart-plot > .gj-m-chart-indicator（left %）> .gj-m-chart-indicator-dot.gj-m-chart-sN（top %）",
    "1.Chart / Column": ".gj-m-chart-bars > .gj-m-chart-bar-group > .gj-m-chart-bar（--v 0–100）",
    "1.Chart / Stacked Column": ".gj-m-chart-bar-group > .gj-m-chart-bar-stack > .gj-m-chart-bar × N",
    "横向正负柱（PC）": ".gj-m-chart-bars-h（--zero）> .gj-m-chart-bar-group > .gj-m-chart-bar(.is-negative)",
    "1.Chart / Donut · *": ".gj-m-chart-pie > svg > path.gj-m-chart-slice + .gj-m-chart-pie-center",
    "1.Chart / Pie · *": ".gj-m-chart-pie.gj-m-chart-pie-lg > svg + .gj-m-chart-pie-label",
    "1.Chart / Segmented Progress": ".gj-m-chart-progress > .gj-m-chart-progress-bar × N",
    "柱状百分比（PC）": ".gj-m-chart-percent > .gj-m-chart-percent-seg（--v）",
    "1.Chart / Radar": ".gj-m-chart-radar",
    "1.Chart / Gauge": ".gj-m-chart-gauge.gj-m-chart-gauge-half | -three",
    "1.Chart / Single Progress · Progress List": ".gj-m-chart-progress(-lg)、.gj-m-chart-progress-list",
    "环状进度（PC）": ".gj-m-chart-ring",
    "词云（PC）": ".gj-m-chart-cloud > .gj-m-chart-cloud-item",
    "chart_item/data_card Property 1=data_detail_card": ".gj-m-chart-tip.gj-m-chart-tip-single > .gj-m-chart-tip-name.gj-m-chart-sN + .gj-m-chart-tip-value > .gj-m-chart-tip-unit",
    "chart_item/data_card Property 1=Variant2": ".gj-m-chart-tip > .gj-m-chart-tip-row × N（.gj-m-chart-tip-name + .gj-m-chart-tip-value）",
    "绘图视口高度": "templates.plotViewport：默认166（1.66rem），标题/图例/X标签/导航独立计量；height与heightRem显式变更需同步"
  },
  "valueMap": {
    "axis": "{\"plot\": \"绘图区高 --gj-m-chart-h（默认 166），左侧 Y 标签宽 --gj-m-chart-y-w（默认 28），顶部留 9\", \"grid\": \"1px Border/default；默认虚线 2/2（.gj-m-chart-ytick），.is-solid / .gj-m-chart-axes-solid 实线；数值 0 的基线实线（无 0 时最下方一条）\", \"yLabel\": \"P5_CN-R 12/18 Text/Tiatery，右对齐，垂直居中于网格线，距绘图区 8\", \"xLabel\": \"P5_CN-R 12/18 Text/Tiatery，居中于刻度，距绘图区 8；首末 .is-start / .is-end 贴边\", \"xTick\": \".gj-m-chart-xaxis-tick：刻度线 1 × 8（虚线 / .gj-m-chart-xax…（完整见 schema.json）",
    "a11y": "图表容器 role=img + aria-label 写结论（如“近1月累计收益率走势，最新 5.2%”）；必要时提供数据表",
    "legend": "{\"item\": \".gj-m-legend：标记 + 名称，间距 4；名称 P5_CN-R 12/18 Text/Secondary；颜色 --gj-m-legend-color\", \"marks\": {\"line\": \".is-line：16 框内 12 × 3，圆角 2（折线 / 面积）\", \"dotline\": \".is-dotline：16 × 2 线 + 8 圆点（白 1px 描边）\", \"dot\": \".is-dot：8 圆点（饼图 / 散点）\", \"stack\": \".is-stack：8 方块，圆角 2（柱状 / 堆叠 / 环形）\"}, \"data\": \".gj-m-legend-data：图例 + 数值 .gj-m-legend-value（H6-CN-S 13/20 Text/Primary），间距 12\", \"layout\": \"横向 .gj-m-chart-leg…（完整见 schema.json）",
    "palette": "系列按 Chart/CH01 → CH10 顺序取色，超过 10 个循环；.gj-m-chart-s1…s10（设计方 2026-10-15）",
    "line": "{\"series\": \"1–5 条，颜色按 Chart/CH01→CH10 顺序（.gj-m-chart-s1…）\", \"stroke\": {\"width\": 2, \"join\": \"miter\", \"cap\": \"butt（Figma NONE）\"}, \"styles\": {\"Default\": \"仅折线\", \"Fill\": \"折线 + 系列色线性渐变面积，折线最高点 30% → 绘图区底 0%；仅 1–2 条\"}, \"order\": \"先画全部面积，再画全部折线\", \"recommend\": {\"maxSeries\": 5, \"fillMaxSeries\": 2}, \"points\": \"无数据点\"}",
    "indicator": "{\"line\": \"1px 虚线 2/2 Background/MK_20，贯穿绘图区\", \"dot\": \"直径 8，系列色填充，1px 白色内描边（Primitive/Neutral/N01）\", \"behavior\": \"点按 / 拖动吸附最近数据点，抬手保持，再点同一点取消；多系列显示全部可见系列节点\"}",
    "types": "{\"curve\": {\"class\": \"path.gj-m-chart-line / path.gj-m-chart-area\", \"smoothing\": \"单调三次插值（Fritsch–Carlson）\"}, \"bar\": {\"class\": \".gj-m-chart-bars / .gj-m-chart-bars-h > .gj-m-chart-bar-group > .gj-m-chart-bar\", \"single\": \"宽 16、圆角 4\", \"grouped\": \"每柱 12、组内间距 4、圆角 2\", \"stacked\": \".gj-m-chart-bar-stack 宽 16、分段间距 2、圆角 2\", \"posNeg\": \"0 基线 --zero，正 CH01 / 负 CH02 .is-negative\", \"label\": \".gj-m-chart-bar-labe…（完整见 schema.json）",
    "dataCard": "{\"class\": \".gj-m-chart-plot > .gj-m-chart-tip(.gj-m-chart-tip-single)(.is-left)\", \"bg\": \"Background/MK_60\", \"radius\": 8, \"padding\": 12, \"gap\": 4, \"minWidth\": 148, \"text\": \"Text/reversal\", \"single\": \"标记 + 名称 P5；数值 16/24 + 单位 P5\", \"multi\": \"行高 22，名称 P5 在左、数值 14/22 + 单位 P5 在右，间距 12\", \"mark\": \"8 圆点 系列色\", \"position\": \"贴绘图区顶，竖线右侧 8；> 55% 时放左侧\", \"numberFont\": \"普通 UI 字体 Regular（Figma 为 GJType Medium，按用户规则…（完整见 schema.json）"
  },
  "tokenMap": {
    "Border/default": "--ds-border-default",
    "Text/Tiatery": "--ds-text-tiatery",
    "Text/Secondary": "--ds-text-secondary",
    "Text/Primary": "--ds-text-primary",
    "Text/reversal": "--ds-text-reversal",
    "Chart/CH01–CH10": "--ds-chart-ch01 … --ds-chart-ch10"
  },
  "runtimeMap": {
    "progressList": ".gj-m-chart-progress-list",
    "progressItem": ".gj-m-chart-progress-item",
    "bar": ".gj-m-chart-progress-bar",
    "legend": ".gj-m-chart-legend",
    "axes": ".gj-m-chart-axes",
    "plot": ".gj-m-chart-plot"
  },
  "markup": {
    "progressInline": "<ul class=\"gj-m-chart-progress-list gj-m-chart-progress-list-inline\"><li class=\"gj-m-chart-progress-item\"><span class=\"gj-m-chart-progress-name\">五星</span><div class=\"gj-m-chart-progress\" role=\"progressbar\" aria-valuenow=\"40\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"五星 2 家\"><div class=\"gj-m-chart-progress-bar\" style=\"--v:40\"></div></div><span class=\"gj-m-chart-progress-value\">2 家</span></li></ul>",
    "progressBlock": "<ul class=\"gj-m-chart-progress-list\"><li class=\"gj-m-chart-progress-item\"><div class=\"gj-m-chart-progress-head\"><span class=\"gj-m-chart-progress-name\">新增有效户</span><span class=\"gj-m-chart-progress-value\">72%</span></div><div class=\"gj-m-chart-progress gj-m-chart-progress-lg\" role=\"progressbar\" aria-valuenow=\"72\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"新增有效户\"><div class=\"gj-m-chart-progress-bar gj-m-chart-s1\" style=\"--v:72\"></div></div></li><li class=\"gj-m-chart-progress-item\"><div class=\"gj-m-chart-progress-head\"><span class=\"gj-m-chart-progress-name\">客户资产 AUM</span><span class=\"gj-m-chart-progress-value\">56%</span></div><div class=\"gj-m-chart-progress gj-m-chart-progress-lg\" role=\"progressbar\" aria-valuenow=\"56\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"客户资产 AUM\"><div class=\"gj-m-chart-progress-bar gj-m-chart-s2\" style=\"--v:56\"></div></div></li><li class=\"gj-m-chart-progress-item\"><div class=\"gj-m-chart-progress-head\"><span class=\"gj-m-chart-progress-name\">产品销售额</span><span class=\"gj-m-chart-progress-value\">38%</span></div><div class=\"gj-m-chart-progress gj-m-chart-progress-lg\" role=\"progressbar\" aria-valuenow=\"38\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"产品销售额\"><div class=\"gj-m-chart-progress-bar gj-m-chart-s3\" style=\"--v:38\"></div></div></li><li class=\"gj-m-chart-progress-item\"><div class=\"gj-m-chart-progress-head\"><span class=\"gj-m-chart-progress-name\">客户满意度</span><span class=\"gj-m-chart-progress-value\">91%</span></div><div class=\"gj-m-chart-progress gj-m-chart-progress-lg\" role=\"progressbar\" aria-valuenow=\"91\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"客户满意度\"><div class=\"gj-m-chart-progress-bar gj-m-chart-s4\" style=\"--v:91\"></div></div></li></ul>",
    "legend": "<div class=\"gj-m-chart-legend\" style=\"justify-content:space-between\"><span class=\"gj-m-legend gj-m-chart-s1\"><span class=\"gj-m-legend-mark is-line\" aria-hidden=\"true\"></span>线</span><span class=\"gj-m-legend gj-m-chart-s1\"><span class=\"gj-m-legend-mark is-dotline\" aria-hidden=\"true\"></span>线 + 点</span><span class=\"gj-m-legend gj-m-chart-s1\"><span class=\"gj-m-legend-mark is-dot\" aria-hidden=\"true\"></span>圆点</span><span class=\"gj-m-legend gj-m-chart-s1\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>方块</span></div>",
    "axes": "<div class=\"gj-m-chart-axes\" style=\"--gj-m-chart-h:1.4rem;\"><div class=\"gj-m-chart-ytick\" style=\"top:0%\"><span class=\"gj-m-chart-ylabel\">6</span></div><div class=\"gj-m-chart-ytick\" style=\"top:25%\"><span class=\"gj-m-chart-ylabel\">4</span></div><div class=\"gj-m-chart-ytick\" style=\"top:50%\"><span class=\"gj-m-chart-ylabel\">2</span></div><div class=\"gj-m-chart-ytick is-solid\" style=\"top:75%\"><span class=\"gj-m-chart-ylabel\">0</span></div><div class=\"gj-m-chart-ytick\" style=\"top:100%\"><span class=\"gj-m-chart-ylabel\">-2</span></div><div class=\"gj-m-chart-plot\"><svg class=\"gj-m-chart-line-svg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><polyline class=\"gj-m-chart-line gj-m-chart-s1\" points=\"0.00,75.00 16.67,60.00 33.33,65.00 50.00,42.50 66.67,36.25 83.33,45.00 100.00,17.50\"></polyline></svg></div></div>",
    "fromPreview_chart_legend_v": "<div class=\"gj-m-chart-legend-v\"><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s1\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>股票</span><span class=\"gj-m-legend-value\">42.6%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s2\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>债券</span><span class=\"gj-m-legend-value\">28.4%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s3\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>货币</span><span class=\"gj-m-legend-value\">18.0%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s4\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>其他</span><span class=\"gj-m-legend-value\">11.0%</span></span></div>",
    "fromPreview_chart_bar_label": "<div class=\"gj-m-chart-axes\" style=\"--gj-m-chart-h:1.4rem;\"><div class=\"gj-m-chart-ytick\" style=\"top:0%\"><span class=\"gj-m-chart-ylabel\">80</span></div><div class=\"gj-m-chart-ytick\" style=\"top:25%\"><span class=\"gj-m-chart-ylabel\">60</span></div><div class=\"gj-m-chart-ytick\" style=\"top:50%\"><span class=\"gj-m-chart-ylabel\">40</span></div><div class=\"gj-m-chart-ytick\" style=\"top:75%\"><span class=\"gj-m-chart-ylabel\">20</span></div><div class=\"gj-m-chart-ytick is-solid\" style=\"top:100%\"><span class=\"gj-m-chart-ylabel\">0</span></div><div class=\"gj-m-chart-plot\"><div class=\"gj-m-chart-bars\"><div class=\"gj-m-chart-bar-group\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:52.5\"><span class=\"gj-m-chart-bar-label\">42</span></div></div><div class=\"gj-m-chart-bar-group\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:70\"><span class=\"gj-m-chart-bar-label\">56</span></div></div><div class=\"gj-m-chart-bar-group\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:47.5\"><span class=\"gj-m-chart-bar-label\">38</span></div></div><div class=\"gj-m-chart-bar-group\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:80\"><span class=\"gj-m-chart-bar-label\">64</span></div></div><div class=\"gj-m-chart-bar-group\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:62.5\"><span class=\"gj-m-chart-bar-label\">50</span></div></div><div class=\"gj-m-chart-bar-group\"><div class=\"gj-m-chart-bar gj-m-chart-s1\" style=\"--v:90\"><span class=\"gj-m-chart-bar-label\">72</span></div></div></div></div></div>",
    "fromPreview_chart_pie_wrap": "<div class=\"gj-m-chart-pie-wrap\"><div class=\"gj-m-chart-pie\" role=\"img\" aria-label=\"资产配置：股票36%，债券26%，基金20%，其他18%\"><svg viewBox=\"0 0 100 100\" aria-hidden=\"true\"><path class=\"gj-m-chart-slice gj-m-chart-s1\" d=\"M50,0 A50,50 0 0 1 88.52566213878947,81.8711994874345 L78.50898998270421,73.58468762070152 A37,37 0 0 0 50,13 Z\"></path><path class=\"gj-m-chart-slice gj-m-chart-s2\" d=\"M88.52566213878947,81.8711994874345 A50,50 0 0 1 15.772644703565561,86.44843137107057 L24.671757080638518,76.97183921459222 A37,37 0 0 0 78.50898998270421,73.58468762070152 Z\"></path><path class=\"gj-m-chart-slice gj-m-chart-s3\" d=\"M15.772644703565561,86.44843137107057 A50,50 0 0 1 4.758647376699024,28.71103542174637 L16.521399058757275,34.24616621209231 A37,37 0 0 0 24.671757080638518,76.97183921459222 Z\"></path><path class=\"gj-m-chart-slice gj-m-chart-s4\" d=\"M4.758647376699024,28.71103542174637 A50,50 0 0 1 49.999999999999986,0 L49.99999999999999,13 A37,37 0 0 0 16.521399058757275,34.24616621209231 Z\"></path></svg><div class=\"gj-m-chart-pie-center\"><span class=\"gj-m-chart-pie-total\">508</span><span class=\"gj-m-chart-pie-unit\">万元</span></div></div><div class=\"gj-m-chart-legend-v\"><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s1\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>股票</span><span class=\"gj-m-legend-value\">36%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s2\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>债券</span><span class=\"gj-m-legend-value\">26%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s3\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>基金</span><span class=\"gj-m-legend-value\">20%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s4\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>其他</span><span class=\"gj-m-legend-value\">18%</span></span></div></div>",
    "fromPreview_chart_block": "<div class=\"gj-m-chart-block\"><div class=\"gj-m-chart-block-head\"><span style=\"font-size:.14rem;line-height:.22rem\">项目总数</span><span class=\"gj-m-legend-value\">2,821 项</span></div><div class=\"gj-m-chart-percent\" role=\"img\" aria-label=\"占比\"><div class=\"gj-m-chart-percent-seg gj-m-chart-s1\" style=\"--v:62\"></div><div class=\"gj-m-chart-percent-seg gj-m-chart-s2\" style=\"--v:38\"></div></div><div class=\"gj-m-chart-legend\"><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s1\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>投行</span><span class=\"gj-m-legend-value\">62%</span></span><span class=\"gj-m-legend-data\"><span class=\"gj-m-legend gj-m-chart-s2\"><span class=\"gj-m-legend-mark is-stack\" aria-hidden=\"true\"></span>财富</span><span class=\"gj-m-legend-value\">38%</span></span></div></div>",
